# Streamlit Community Cloud secrets template.
#
# ONLY OPENAI_API_KEY IS REQUIRED. Every other variable below has a
# built-in default in src/config.py (DEFAULT_MODEL, and reasonable
# temperature/budget defaults) — include them only if you want to
# override something.
#
# This is NOT read automatically from the repo — it's a reference only.
# On share.streamlit.io: open your app -> Settings -> Secrets, and paste
# the contents below (with real values) into that box. Streamlit injects
# these as st.secrets at runtime; streamlit_app.py copies them into
# os.environ before src.config is imported, so the rest of the codebase
# is unaware it's running on Streamlit Cloud rather than locally from .env.
#
# Never commit a real secrets.toml with actual values — .gitignore already
# excludes .streamlit/secrets.toml (only this .example file is tracked).

OPENAI_API_KEY = "sk-..."

# --- everything below is optional; shown with its default value ---

MODEL_PLANNING = "gpt-6-astra"
MODEL_RESEARCH = "gpt-6-astra"
MODEL_EVIDENCE_ANALYST = "gpt-6-astra-mini"
MODEL_COMPARISON = "gpt-6-astra-mini"
MODEL_SYNTHESIS = "gpt-6-astra"
MODEL_QUALITY_CONTROL = "gpt-6-astra"
MODEL_REQUEST_ANALYSER = "gpt-6-astra-mini"

TEMP_PLANNING = "0.2"
TEMP_RESEARCH = "0.2"
TEMP_EVIDENCE_ANALYST = "0.0"
TEMP_COMPARISON = "0.0"
TEMP_SYNTHESIS = "0.4"
TEMP_QUALITY_CONTROL = "0.0"
TEMP_REQUEST_ANALYSER = "0.1"

MAX_ITERATIONS = "25"
MAX_TOOL_CALLS = "40"
MAX_REPAIR_ROUNDS = "2"
RUN_BUDGET_USD = "2.00"
REQUEST_TIMEOUT_SECONDS = "60"
TOOL_TIMEOUT_SECONDS = "15"
MAX_RETRIES = "4"

LOG_LEVEL = "INFO"
LOG_DIR = "./runs"
